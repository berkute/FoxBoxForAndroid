<resources xmlns:tools="http://android.com">

    <color name="material_orange_500">#FF9800</color>
    <color name="material_orange_700">#F57C00</color>
    <color name="material_orange_100">#FFE0B2</color>
    <color name="material_orange_300">#FFB74D</color>
    <color name="material_orange_accent_200">#FFAB40</color>
    <color name="material_light_black">#212121</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="fab_color_progress">#212121</color>
    <color name="color_pink_ssr">#FF9800</color>
    <color name="color_ng_black_accent">#9E9E9E</color>
    <color name="color_ng_black_primary">#2B2B2B</color>
    <color name="preference_simple_menu_background">#FAFAFA</color>
    <color name="chip_background">#E0E0E0</color>
    <color name="chip_text_color">#212121</color>
    <color name="chip_ripple_color">#BDBDBD</color>

    <integer-array name="material_colors">
        <item>@color/material_orange_500</item>
    </integer-array>

    <style name="Theme.SagerNet" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="actionBarStyle">@style/Widget.MaterialComponents.ActionBar.Solid</item>
        <item name="actionModeCloseDrawable">@drawable/ic_navigation_close</item>
        <item name="colorButtonNormal">?colorAccent</item>
        <item name="android:navigationBarColor">?colorPrimaryDark</item>
        <item name="colorPrimary">@color/material_orange_500</item>
        <item name="colorPrimaryDark">@color/material_orange_700</item>
        <item name="colorAccent">@color/material_orange_accent_200</item>

        <item name="colorMaterial100">@color/material_orange_100</item>
        <item name="colorMaterial300">@color/material_orange_300</item>

        <item name="accentOrTextSecondary">?colorAccent</item>
        <item name="accentOrTextPrimary">?colorAccent</item>
        <item name="primaryOrTextSecondary">?colorPrimary</item>
        <item name="primaryOrTextPrimary">?colorPrimary</item>

        <item name="fabColorBackground">?colorPrimary</item>
        <item name="selectedColorPrimary">?colorPrimary</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="tabTextColor">#99FFFFFF</item>
        <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabIndicatorColor">@color/white</item>
        <item name="tabRippleColor">@color/white</item>
        <item name="whiteOrTextPrimary">@color/white</item>

        <item name="windowActionModeOverlay">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="chipStyle">@style/Widget.MaterialComponents.Chip.Choice.SagerNet</item>
        <item name="itemShapeAppearance">@style/ShapeAppearance.MaterialComponents.MediumComponent</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet</item>
    </style>

    <style name="Theme.SagerNet.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="actionBarStyle">@style/Widget.MaterialComponents.ActionBar.Solid</item>
        <item name="actionModeCloseDrawable">@drawable/ic_navigation_close</item>
        <item name="colorButtonNormal">?colorAccent</item>
        <item name="android:navigationBarColor">?colorPrimaryDark</item>
        <item name="colorPrimary">@color/material_orange_500</item>
        <item name="colorPrimaryDark">@color/material_orange_700</item>
        <item name="colorAccent">@color/material_orange_accent_200</item>

        <item name="colorMaterial100">@color/material_orange_100</item>
        <item name="colorMaterial300">@color/material_orange_300</item>

        <item name="accentOrTextSecondary">?colorAccent</item>
        <item name="accentOrTextPrimary">?colorAccent</item>
        <item name="primaryOrTextSecondary">?colorPrimary</item>
        <item name="primaryOrTextPrimary">?colorPrimary</item>

        <item name="fabColorBackground">?colorPrimary</item>
        <item name="selectedColorPrimary">?colorPrimary</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="tabTextColor">#99FFFFFF</item>
        <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabIndicatorColor">@color/white</item>
        <item name="tabRippleColor">@color/white</item>
        <item name="whiteOrTextPrimary">@color/white</item>

        <item name="windowActionModeOverlay">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="chipStyle">@style/Widget.MaterialComponents.Chip.Choice.SagerNet</item>
        <item name="itemShapeAppearance">@style/ShapeAppearance.MaterialComponents.MediumComponent</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet</item>
        <item name="windowFixedHeightMajor" type="dimen">95%</item>
    </style>

    <style name="AppearanceFoundation.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.MaterialComponents.Button.TextButton.Dialog.Primary</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.MaterialComponents.Button.TextButton.Dialog.Primary</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.MaterialComponents.Button.TextButton.Dialog.Flush.Primary</item>
    </style>

    <style name="Widget.MaterialComponents.Button.TextButton.Dialog.Primary"><item name="android:textColor">?primaryOrTextPrimary</item></style>
    <style name="Widget.MaterialComponents.Button.TextButton.Dialog.Flush.Primary"><item name="android:textColor">?primaryOrTextPrimary</item></style>

    <style name="Widget.MaterialComponents.Chip.Choice.SagerNet">
        <item name="textStartPadding">30dp</item>
        <item name="textEndPadding">30dp</item>
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="checkedIconTint">?primaryOrTextPrimary</item>
        <item name="rippleColor">@color/chip_ripple_color</item>
    </style>

    <style name="Theme.SagerNet.Orange"><item name="colorPrimary">@color/material_orange_500</item></style>
    <style name="Theme.SagerNet.Dialog.Orange"><item name="colorPrimary">@color/material_orange_500</item></style>
    <style name="Theme.SagerNet.Pink_SSR"><item name="colorPrimary">@color/material_orange_500</item></style>
    <style name="Theme.SagerNet.Amber"><item name="colorPrimary">@color/material_orange_500</item></style>
    <style name="Theme.SagerNet.Blue"><item name="colorPrimary">@color/material_orange_500</item></style>
    <style name="Theme.SagerNet.BlueGrey"><item name="colorPrimary">@color/material_orange_500</item></style>
    <style name="Theme.SagerNet.Brown"><item name="colorPrimary">@color/material_orange_500</item></style>
    <style name="Theme.SagerNet.Cyan"><item name="colorPrimary">@color/material_orange_500</item></style>
    <style name="Theme.SagerNet.DeepOrange"><item name="colorPrimary">@color/material_orange_500</item></style>
    <style name="Theme.SagerNet.DeepPurple"><item name="colorPrimary">@color/material_orange_500</item></style>
    <style name="Theme.SagerNet.Green"><item name="colorPrimary">@color/material_orange_500</item></style>
    <style name="Theme.SagerNet.Grey"><item name="colorPrimary">@color/material_orange_500</item></style>
    <style name="Theme.SagerNet.Indigo"><item name="colorPrimary">@color/material_orange_500</item></style>
    <style name="Theme.SagerNet.LightBlue"><item name="colorPrimary">@color/material_orange_500</item></style>
    <style name="Theme.SagerNet.LightGreen"><item name="colorPrimary">@color/material_orange_500</item></style>
    <style name="Theme.SagerNet.Lime"><item name="colorPrimary">@color/material_orange_500</item></style>
    <style name="Theme.SagerNet.Purple"><item name="colorPrimary">@color/material_orange_500</item></style>
    <style name="Theme.SagerNet.Red"><item name="colorPrimary">@color/material_orange_500</item></style>
    <style name="Theme.SagerNet.Teal"><item name="colorPrimary">@color/material_orange_500</item></style>
    <style name="Theme.SagerNet.Yellow"><item name="colorPrimary">@color/material_orange_500</item></style>
    <style name="Theme.SagerNet.Black"><item name="colorPrimary">@color/material_orange_500</item></style>
    <style name="Theme.SagerNet.Dialog.Black"><item name="colorPrimary">@color/material_orange_500</item></style>

    <style name="Theme.Start" parent="Theme.MaterialComponents.DayNight">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@android:color/transparent</item>
        <item name="colorPrimaryDark">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
