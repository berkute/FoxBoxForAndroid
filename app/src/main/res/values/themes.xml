<resources>
    <!-- Base application theme. -->
    <style name="Theme.SagerNet" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="actionBarStyle">@style/Widget.MaterialComponents.ActionBar.Solid</item>
        <item name="actionModeCloseDrawable">@drawable/ic_navigation_close</item>
        <item name="colorButtonNormal">?colorAccent</item>
        <item name="android:navigationBarColor">?colorPrimaryDark</item>
        <item name="colorPrimary">#FF9800</item>
        <item name="colorPrimaryDark">#E65100</item>
        <item name="colorAccent">#FFCC80</item>

        <item name="colorMaterial100">#FFCC80</item>
        <item name="colorMaterial300">#FF9800</item>

        <item name="accentOrTextSecondary">?colorAccent</item>
        <item name="accentOrTextPrimary">?colorAccent</item>
        <item name="primaryOrTextSecondary">?colorPrimary</item>
        <item name="primaryOrTextPrimary">?colorPrimary</item>

        <item name="fabColorBackground">?colorPrimary</item>
        <item name="selectedColorPrimary">?colorPrimary</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="tabTextColor">#99FFFFFF</item>
        <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabIndicatorColor">@color/white</item>
        <item name="tabRippleColor">@color/white</item>
        <item name="whiteOrTextPrimary">@color/white</item>

        <item name="windowActionModeOverlay">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="chipStyle">@style/Widget.MaterialComponents.Chip.Choice.SagerNet</item>
        <item name="itemShapeAppearance">@style/ShapeAppearance.MaterialComponents.MediumComponent</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet</item>
    </style>

    <style name="Theme.SagerNet.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="actionBarStyle">@style/Widget.MaterialComponents.ActionBar.Solid</item>
        <item name="actionModeCloseDrawable">@drawable/ic_navigation_close</item>
        <item name="colorButtonNormal">?colorAccent</item>
        <item name="android:navigationBarColor">?colorPrimaryDark</item>
        <item name="colorPrimary">#FF9800</item>
        <item name="colorPrimaryDark">#E65100</item>
        <item name="colorAccent">#FFCC80</item>

        <item name="colorMaterial100">#FFCC80</item>
        <item name="colorMaterial300">#FF9800</item>

        <item name="accentOrTextSecondary">?colorAccent</item>
        <item name="accentOrTextPrimary">?colorAccent</item>
        <item name="primaryOrTextSecondary">?colorPrimary</item>
        <item name="primaryOrTextPrimary">?colorPrimary</item>

        <item name="fabColorBackground">?colorPrimary</item>
        <item name="selectedColorPrimary">?colorPrimary</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="tabTextColor">#99FFFFFF</item>
        <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabIndicatorColor">@color/white</item>
        <item name="tabRippleColor">@color/white</item>
        <item name="whiteOrTextPrimary">@color/white</item>

        <item name="windowActionModeOverlay">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="chipStyle">@style/Widget.MaterialComponents.Chip.Choice.SagerNet</item>
        <item name="itemShapeAppearance">@style/ShapeAppearance.MaterialComponents.MediumComponent</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet</item>
        <item name="windowFixedHeightMajor" type="dimen">95%</item>
    </style>

    <style name="AppearanceFoundation.Title" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.MaterialComponents.Button.TextButton.Dialog.Primary</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.MaterialComponents.Button.TextButton.Dialog.Primary</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.MaterialComponents.Button.TextButton.Dialog.Flush.Primary</item>
    </style>

    <style name="Widget.MaterialComponents.Button.TextButton.Dialog.Primary"><item name="android:textColor">?primaryOrTextPrimary</item></style>
    <style name="Widget.MaterialComponents.Button.TextButton.Dialog.Flush.Primary"><item name="android:textColor">?primaryOrTextPrimary</item></style>

    <style name="Widget.MaterialComponents.Chip.Choice.SagerNet">
        <item name="textStartPadding">30dp</item>
        <item name="textEndPadding">30dp</item>
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="checkedIconTint">?primaryOrTextPrimary</item>
        <item name="rippleColor">@color/chip_ripple_color</item>
    </style>

    <!-- Перенаправляем все подтемы на оранжевый HEX-код -->
    <style name="Theme.SagerNet.Orange"><item name="colorPrimary">#FF9800</item></style>
    <style name="Theme.SagerNet.Dialog.Orange"><item name="colorPrimary">#FF9800</item></style>
    <style name="Theme.SagerNet.Pink_SSR"><item name="colorPrimary">#FF9800</item></style>
    <style name="Theme.SagerNet.Amber"><item name="colorPrimary">#FF9800</item></style>
    <style name="Theme.SagerNet.Blue"><item name="colorPrimary">#FF9800</item></style>
    <style name="Theme.SagerNet.BlueGrey"><item name="colorPrimary">#FF9800</item></style>
    <style name="Theme.SagerNet.Brown"><item name="colorPrimary">#FF9800</item></style>
    <style name="Theme.SagerNet.Cyan"><item name="colorPrimary">#FF9800</item></style>
    <style name="Theme.SagerNet.DeepOrange"><item name="colorPrimary">#FF9800</item></style>
    <style name="Theme.SagerNet.DeepPurple"><item name="colorPrimary">#FF9800</item></style>
    <style name="Theme.SagerNet.Green"><item name="colorPrimary">#FF9800</item></style>
    <style name="Theme.SagerNet.Grey"><item name="colorPrimary">#FF9800</item></style>
    <style name="Theme.SagerNet.Indigo"><item name="colorPrimary">#FF9800</item></style>
    <style name="Theme.SagerNet.LightBlue"><item name="colorPrimary">#FF9800</item></style>
    <style name="Theme.SagerNet.LightGreen"><item name="colorPrimary">#FF9800</item></style>
    <style name="Theme.SagerNet.Lime"><item name="colorPrimary">#FF9800</item></style>
    <style name="Theme.SagerNet.Purple"><item name="colorPrimary">#FF9800</item></style>
    <style name="Theme.SagerNet.Red"><item name="colorPrimary">#FF9800</item></style>
    <style name="Theme.SagerNet.Teal"><item name="colorPrimary">#FF9800</item></style>
    <style name="Theme.SagerNet.Yellow"><item name="colorPrimary">#FF9800</item></style>
    <style name="Theme.SagerNet.Black"><item name="colorPrimary">#FF9800</item></style>
    <style name="Theme.SagerNet.Dialog.Black"><item name="colorPrimary">#FF9800</item></style>

    <style name="Theme.Start" parent="Theme.MaterialComponents.DayNight">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@android:color/transparent</item>
        <item name="colorPrimaryDark">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
